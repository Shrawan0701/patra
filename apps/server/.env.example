# Local PostgreSQL (pgAdmin)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@127.0.0.1:5432/patra?schema=public"

PORT=4000
JWT_SECRET="replace-with-a-strong-random-jwt-secret"

# Brevo Transactional Email (Forgot Password 6-digit OTP)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="support@patra.media"
BREVO_SENDER_NAME="Patra"

# Dodo Payments (Global USD + India INR)
DODO_API_KEY="dodo_test_your_dodo_api_key"
DODO_WEBHOOK_SECRET="whsec_your_dodo_webhook_secret"
DODO_ENVIRONMENT="test_mode"
DODO_PRODUCT_SINGLE_INR="pdt_your_single_inr_product_id"
DODO_PRODUCT_SINGLE_USD="pdt_your_single_usd_product_id"
DODO_PRODUCT_MONTHLY_INR="pdt_your_monthly_inr_product_id"
DODO_PRODUCT_MONTHLY_USD="pdt_your_monthly_usd_product_id"
DODO_PRODUCT_YEARLY_INR="pdt_your_yearly_inr_product_id"
DODO_PRODUCT_YEARLY_USD="pdt_your_yearly_usd_product_id"

APP_RETURN_URL="patra://payment-success"

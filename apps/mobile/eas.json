{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://patra-orfr.onrender.com",
        "EXPO_PUBLIC_STUDIO_URL": "https://studio.patra.media"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://patra-orfr.onrender.com",
        "EXPO_PUBLIC_STUDIO_URL": "https://studio.patra.media"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
